# --- Database (Neon Postgres) ---
# Vercel project > Storage tab > Create Database > Neon sets this automatically.
# For local work: npx vercel env pull .env.local
DATABASE_URL=

# --- Auth ---
# Any long random string — used to sign access tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Password reset email (Resend: resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="Zara GNC <onboarding@resend.dev>"
# Used to build the reset-password link; defaults to the production URL if unset.
PUBLIC_URL=https://zara-react.vercel.app

# --- Cloudinary (Dashboard > API Keys) — used for signed uploads, see
# backend/cloudinary-signature.js. Cloud name is shown at the top of the dashboard. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
