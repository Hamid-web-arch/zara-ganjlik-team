rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.accessLevel == 'admin') ||
        (exists(/databases/$(database)/documents/crew/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/crew/$(request.auth.uid)).data.accessLevel == 'admin')
      );
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A self-update may only ever touch the "image" field — name/role/idCode/email/
    // accessLevel are admin-managed. This is what stops a staff member from granting
    // themselves accessLevel: "admin" via the browser console.
    function isSelfImageOnlyUpdate(userId) {
      return isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['image']);
    }

    // staff / crew: public read (used for the home page team list), but write access is
    // either full admin control, or a signed-in member touching only their own avatar.
    match /staff/{userId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isSelfImageOnlyUpdate(userId);
    }
    match /crew/{userId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isSelfImageOnlyUpdate(userId);
    }

    // Site-wide settings (hero section, energy video) — admin only.
    match /settings/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // Moments: staff-internal feed.
    // - Anyone signed in can propose a moment, but it must start out "pending" with no
    //   likes — it cannot be self-published as "approved" by skipping moderation.
    // - A signed-in user may toggle likes, but the update must touch *only* the
    //   likedBy field, and only add/remove their own uid (not anyone else's).
    // - Only admins can approve/reject/remove (status changes and deletes).
    match /approved_moments/{momentId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.resource.data.status == 'pending' &&
        (!('likedBy' in request.resource.data) || request.resource.data.likedBy.size() == 0);

      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']) &&
        request.resource.data.likedBy.toSet()
          .difference(resource.data.likedBy.toSet())
          .difference([request.auth.uid].toSet()).size() == 0 &&
        resource.data.likedBy.toSet()
          .difference(request.resource.data.likedBy.toSet())
          .difference([request.auth.uid].toSet()).size() == 0
      );

      allow delete: if isAdmin();
    }

    // Comments (shared by moments + briefings): the author uid in the document must
    // match the signed-in uid, so nobody can post or delete as someone else. Admins can
    // still moderate (delete) any comment. Comments are otherwise immutable (no edit UI).
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || (request.auth != null && resource.data.authorUid == request.auth.uid);
    }

    // Briefings: rəsmi videolar — hər login olmuş istifadəçi oxuya bilər, yalnız admin yükləyə/silə bilər
    match /briefings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Qalan hər şey (məs. work_schedule) üçün: oxumaq login tələb edir, yazmaq yalnız admin
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
